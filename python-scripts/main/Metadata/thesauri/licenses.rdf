<skos:Concept rdf:about="https://creativecommons.org/publicdomain/zero/1.0/deed.en"> 
	<skos:prefLabel xml:lang="fr">Creative Commons (CC-0) - aucune condition de réutilisation, les données sont dans le domaine public. La licence complète est disponible ici : https://creativecommons.org/publicdomain/zero/1.0/legalcode</skos:prefLabel>
	<skos:prefLabel xml:lang="nl">Creative Commons (CC-0) - geen voorwaarden voor hergebruik, de gegevens zijn in het publieke domein. De volledige licentie is hier beschikbaar: https://creativecommons.org/publicdomain/zero/1.0/legalcode</skos:prefLabel>
	<skos:prefLabel xml:lang="en">Creative Commons (CC-0) - no conditions for reuse, the data is in the public domain. The full license is available here: https://creativecommons.org/publicdomain/zero/1.0/legalcode</skos:prefLabel>
</skos:Concept>

<skos:Concept rdf:about="https://creativecommons.org/licenses/by/4.0/"> 
	<skos:prefLabel xml:lang="fr">Creative Commons Attribution (CC-BY) - citation requise de la source de la donnée. La licence complète est disponible ici : https://creativecommons.org/licenses/by/4.0/legalcode</skos:prefLabel>
	<skos:prefLabel xml:lang="nl">Creative Commons Attribution (CC-BY) - vereiste vermelding van gegevensbron. De volledige licentie is hier beschikbaar: https://creativecommons.org/licenses/by/4.0/legalcode</skos:prefLabel>
	<skos:prefLabel xml:lang="en">Creative Commons Attribution (CC-BY) - required citation of data source. The full license is available here: https://creativecommons.org/licenses/by/4.0/legalcode</skos:prefLabel>
</skos:Concept>

<skos:Concept rdf:about="https://www.ejustice.just.fgov.be/eli/arrete/2018/02/01/2018010589/justel"> 
	<skos:prefLabel xml:lang="fr">Réutilisation libre moyennant paiement d'une redevance. La licence complète est disponible ici : https://www.ejustice.just.fgov.be/eli/arrete/2018/02/01/2018010589/justel</skos:prefLabel>
